config BR2_PACKAGE_FLATPAK
	bool "flatpak"
	depends on BR2_TOOLCHAIN_USES_GLIBC # ostree
	depends on !BR2_STATIC_LIBS
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_USE_MMU
	depends on BR2_USE_WCHAR
	depends on BR2_PACKAGE_SYSTEMD
	select BR2_PACKAGE_OSTREE
	select BR2_PACKAGE_APPSTREAM
	select BR2_PACKAGE_LIBGLIB2
	select BR2_PACKAGE_LIBCAP
	select BR2_PACKAGE_LIBARCHIVE
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_LIBXML2
	select BR2_PACKAGE_LIBFUSE3
	select BR2_PACKAGE_JSON_GLIB
	select BR2_PACKAGE_GDK_PIXBUF
	select BR2_PACKAGE_LIBGPGME
	select BR2_PACKAGE_LIBSECCOMP
	select BR2_PACKAGE_BUBBLEWRAP
	select BR2_PACKAGE_XDG_DBUS_PROXY
	select BR2_PACKAGE_ZSTD
	help
	  Flatpak: sandboxed application distribution. Lets Fusion OS
	  run Steam (with its own 32-bit runtime), Discord, Heroic and
	  Firefox from Flathub on a from-source base.

	  https://flatpak.org/

comment "flatpak needs systemd and a glibc toolchain w/ wchar, threads, dynamic library"
	depends on BR2_USE_MMU
	depends on !BR2_PACKAGE_SYSTEMD || !BR2_TOOLCHAIN_USES_GLIBC || \
		!BR2_USE_WCHAR || !BR2_TOOLCHAIN_HAS_THREADS || BR2_STATIC_LIBS
