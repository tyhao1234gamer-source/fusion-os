# Fusion OS - Buildroot defconfig (x86-64, built entirely from source)
# Produces a UEFI-bootable disk image. Everything below is compiled from
# upstream source by Buildroot -- this is not a repackaged distro.

# --- Target architecture ---
BR2_x86_64=y

# --- Toolchain: glibc + C++ (needed by systemd and, later, the gaming stack) ---
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# Kernel headers must match the kernel series, otherwise Buildroot defaults to
# 2.6 headers, glibc becomes unselectable and it silently falls back to uClibc.
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y

# --- Init / system: systemd (the honest base for services + our units) ---
BR2_INIT_SYSTEMD=y
BR2_PACKAGE_SYSTEMD_NETWORKD=y
BR2_PACKAGE_SYSTEMD_RESOLVED=y
BR2_TARGET_GENERIC_HOSTNAME="fusion"
BR2_TARGET_GENERIC_ISSUE="Fusion OS (built from source)"
BR2_TARGET_GENERIC_ROOT_PASSWD="fusion"
BR2_TARGET_GENERIC_GETTY_PORT="tty1"
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_FUSION_PATH)/board/fusion/users.table"
# Services the first-run setup wizard drives: timedatectl, localectl, logins.
BR2_PACKAGE_SYSTEMD_TIMEDATED=y
BR2_PACKAGE_SYSTEMD_TIMESYNCD=y
BR2_PACKAGE_SYSTEMD_LOCALED=y
BR2_PACKAGE_SYSTEMD_LOGIND=y
# Data those services need: keymaps, time zones, locales.
BR2_PACKAGE_KBD=y
BR2_TARGET_TZ_INFO=y
BR2_GENERATE_LOCALE="pt_PT.UTF-8 pt_BR.UTF-8 es_ES.UTF-8 en_US.UTF-8 en_GB.UTF-8 fr_FR.UTF-8 de_DE.UTF-8"
# TLS trust store (Flathub, Steam, browsers).
BR2_PACKAGE_CA_CERTIFICATES=y

# --- Linux kernel: our config fragment on top of the arch default ---
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.118"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_FUSION_PATH)/board/fusion/linux-fragment.config"
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
# objtool (x86-64 kernels) needs host libelf (gelf.h), or the kernel build fails.
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# --- Python 3: the Fusion tools are stdlib-only Python ---
BR2_PACKAGE_PYTHON3=y


# --- Useful base userland ---
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_PCIUTILS=y
BR2_PACKAGE_SUDO=y

# --- Root filesystem: ext4 ---
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="2G"

# --- Bootloader: GRUB2 for legacy BIOS + 64-bit UEFI + 32-bit UEFI ---
# One hybrid GPT image boots all three (see board/fusion/genimage.cfg).
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_I386_PC=y
BR2_TARGET_GRUB2_I386_EFI=y
BR2_TARGET_GRUB2_X86_64_EFI=y
# BIOS core.img prefix: partition 1 (the ESP) of the drive the BIOS booted.
BR2_TARGET_GRUB2_BOOT_PARTITION=",gpt1"

# --- Rootfs overlay + post scripts (identity, image assembly) ---
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_FUSION_PATH)/board/fusion/rootfs-overlay $(BR2_EXTERNAL_FUSION_PATH)/board/fusion/overlay-generated $(BR2_EXTERNAL_FUSION_PATH)/board/fusion/overlay-base"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_FUSION_PATH)/board/fusion/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_FUSION_PATH)/board/fusion/post-image.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="$(BR2_EXTERNAL_FUSION_PATH)/board/fusion/genimage.cfg"

# --- Host tools to build the bootable image ---
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y

# Firmware for the most common wired NICs (all editions): Realtek r8169 /
# r8152 (USB-C adapters) and Broadcom tg3. Without it these NICs either fail
# or run degraded.
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_8169=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_815X=y
BR2_PACKAGE_LINUX_FIRMWARE_BROADCOM_TIGON3=y

# Installer tools (fusion-install-disk): mkfs.ext4 and partx.
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y

# Found by the first real QEMU boot (run 44934112181):
# - several Fusion scripts (fusion-firstboot, fusion-perf-baseline,
#   fusion-game, fusion-gpu) are bash scripts; busybox sh is not enough.
# - zramctl is a separate util-linux option; without it zram was silently off.
BR2_PACKAGE_BASH=y
BR2_PACKAGE_UTIL_LINUX_ZRAMCTL=y
