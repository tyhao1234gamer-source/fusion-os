# Fusion OS "full" edition -- appended AFTER gaming.fragment.
# Everything the user asked for: Wi-Fi in the setup screen, Steam (Flathub,
# with its own 32-bit runtime), Discord, Epic via Heroic, Firefox, and a
# console-like session that boots straight into Steam Big Picture.
# (Last assignment wins, so these replace the overlay/kernel lists above.)

BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_FUSION_PATH)/board/fusion/rootfs-overlay $(BR2_EXTERNAL_FUSION_PATH)/board/fusion/overlay-full"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_FUSION_PATH)/board/fusion/linux-fragment.config $(BR2_EXTERNAL_FUSION_PATH)/board/fusion/linux-gaming.config $(BR2_EXTERNAL_FUSION_PATH)/board/fusion/linux-full.config"

# --- Networking: NetworkManager (nmcli drives the setup wizard's Wi-Fi) ---
BR2_PACKAGE_NETWORK_MANAGER=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_DBUS=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WIRELESS_REGDB=y

# --- Wi-Fi firmware for the common laptop/desktop chipsets ---
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_7260=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_7265D=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_8265=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_9XXX=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_22000=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_QUZ=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_6E=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW88=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW89=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7921=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7922=y
BR2_PACKAGE_LINUX_FIRMWARE_ATHEROS_10K_QCA9377=y
BR2_PACKAGE_LINUX_FIRMWARE_BRCM_BCM43XX=y

# --- Flatpak (our own packages: ostree, appstream, flatpak) ---
BR2_PACKAGE_FLATPAK=y
BR2_PACKAGE_DBUS=y

# --- Steam is an X11 app: Xwayland inside the cage session ---
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_WLROOTS_XWAYLAND=y

# --- Seat access for cage without root or PAM ---
BR2_PACKAGE_SEATD_DAEMON=y

# --- Grow the root partition to fill the USB/disk on first boot ---
BR2_PACKAGE_SYSTEMD_REPART=y
