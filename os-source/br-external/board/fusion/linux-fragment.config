# Fusion kernel options, merged on top of the upstream x86_64_defconfig.
# Additive and safe; the arch default already provides ext4, EFI, cgroups,
# DRM (as modules), vfat, networking.

# Low-latency desktop preemption for interactive gaming.
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# Compressed swap (paired with our zram config).
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZSWAP=y
CONFIG_ZSMALLOC=y
# Since 6.12 zram compressors are separate backends; fusion-zram tries zstd,
# then lz4, then lzo-rle.
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# Input: controllers for the gaming shell.
CONFIG_INPUT_EVDEV=y
CONFIG_HID_SONY=y
CONFIG_JOYSTICK_XPAD=y

# --- Boot-critical, BUILT-IN (there is no initramfs) ---
# Root lives on whatever disk the user boots from: a USB stick, NVMe or SATA.
# These must be =y or the kernel cannot mount root on that machine.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
# 64-bit kernel on 32-bit UEFI firmware (Atom tablets, early Intel Macs).
CONFIG_EFI_MIXED=y
CONFIG_EFI_PARTITION=y
CONFIG_EXT4_FS=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SCSI=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# Display on any UEFI machine before a GPU driver loads.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
# simpledrm only binds to the UEFI framebuffer on x86 through SYSFB_SIMPLEFB;
# without it the screen stays black until a GPU driver loads.
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Filesystems used by live/overlay setups.
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y

# --- Universal hardware coverage (audit 2026-11) ---
# Boot-critical storage beyond AHCI/NVMe, BUILT-IN (no initramfs):
# eMMC/SD (cheap laptops and tablets boot from eMMC).
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_MMC_SDHCI_PLTFM=y
# Realtek card readers (very common in laptops): not boot-critical -> modules.
CONFIG_MISC_RTSX_PCI=m
CONFIG_MISC_RTSX_USB=m
CONFIG_MMC_REALTEK_PCI=m
CONFIG_MMC_REALTEK_USB=m
# Older non-AHCI SATA/PATA controllers (pre-2010 boards) and VMs.
CONFIG_ATA_SFF=y
CONFIG_ATA_BMDMA=y
CONFIG_ATA_PIIX=y
CONFIG_ATA_GENERIC=y
CONFIG_PATA_ACPI=y
CONFIG_SATA_VIA=y
CONFIG_SATA_SIS=y
CONFIG_SATA_NV=y
CONFIG_SATA_SIL=y
CONFIG_SATA_SIL24=y
CONFIG_SATA_PROMISE=y
CONFIG_PATA_AMD=y
CONFIG_PATA_ATIIXP=y
CONFIG_PATA_JMICRON=y
CONFIG_PATA_VIA=y
CONFIG_PATA_SIS=y
CONFIG_PATA_MARVELL=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_VMWARE_PVSCSI=y

# Filesystems on USB sticks / other OSes' disks.
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# Power management, explicit (defaults are expected on, but we rely on them).
CONFIG_ACPI=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_VIDEO=m
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_CPU_IDLE=y
CONFIG_INTEL_IDLE=y
CONFIG_THERMAL=y
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=m
CONFIG_SENSORS_K10TEMP=m

# USB-C, docks, Thunderbolt/USB4.
CONFIG_TYPEC=m
CONFIG_TYPEC_UCSI=m
CONFIG_UCSI_ACPI=m
CONFIG_USB4=m

# Laptop input: I2C-HID touchpads/touchscreens need the I2C controller and
# the GPIO (pinctrl) driver of the platform.
CONFIG_I2C=y
# Parent menus: without them every option below is silently dropped (the CI
# kernel-config check caught 12 such drops on the first build).
CONFIG_PINCTRL=y
CONFIG_GPIOLIB=y
CONFIG_COMMON_CLK=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_HID_ACPI=m
CONFIG_HID_MULTITOUCH=m
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PCI=m
CONFIG_MFD_INTEL_LPSS_PCI=m
CONFIG_MFD_INTEL_LPSS_ACPI=m
CONFIG_PINCTRL_AMD=y
CONFIG_PINCTRL_SUNRISEPOINT=y
CONFIG_PINCTRL_CANNONLAKE=y
CONFIG_PINCTRL_ICELAKE=y
CONFIG_PINCTRL_TIGERLAKE=y
CONFIG_PINCTRL_ALDERLAKE=y
CONFIG_PINCTRL_METEORLAKE=y
CONFIG_PINCTRL_JASPERLAKE=y
CONFIG_PINCTRL_BROXTON=y
CONFIG_PINCTRL_GEMINILAKE=y
CONFIG_HID_GENERIC=y
CONFIG_HID_APPLE=m
CONFIG_HID_LOGITECH=m
CONFIG_HID_LOGITECH_DJ=m
CONFIG_HID_LOGITECH_HIDPP=m
CONFIG_MOUSE_PS2=y
CONFIG_KEYBOARD_ATKBD=y

# Wired networking: modern Intel, USB/USB-C adapters, older Atheros/Marvell/
# NVIDIA chips. Firmware for r8169/r8152 comes from linux-firmware.
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_R8169=m
CONFIG_ALX=m
CONFIG_ATL1C=m
CONFIG_ATL1E=m
CONFIG_SKY2=m
CONFIG_FORCEDETH=m
CONFIG_8139TOO=m
CONFIG_AQTION=m
CONFIG_USB_USBNET=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_RNDIS_HOST=m

# Virtual machine display (QEMU std VGA, VMware/VirtualBox SVGA).
CONFIG_DRM_BOCHS=m
CONFIG_DRM_VMWGFX=m
