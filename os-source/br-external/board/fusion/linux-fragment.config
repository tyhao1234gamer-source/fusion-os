# Fusion kernel options, merged on top of the upstream x86_64_defconfig.
# Additive and safe; the arch default already provides ext4, EFI, cgroups,
# DRM (as modules), vfat, networking.

# Low-latency desktop preemption for interactive gaming.
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# Compressed swap (paired with our zram config).
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZSWAP=y
CONFIG_ZSMALLOC=y
# Since 6.12 zram compressors are separate backends; fusion-zram tries zstd,
# then lz4, then lzo-rle.
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# Input: controllers for the gaming shell.
CONFIG_INPUT_EVDEV=y
CONFIG_HID_SONY=y
CONFIG_JOYSTICK_XPAD=y

# --- Boot-critical, BUILT-IN (there is no initramfs) ---
# Root lives on whatever disk the user boots from: a USB stick, NVMe or SATA.
# These must be =y or the kernel cannot mount root on that machine.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_EXT4_FS=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SCSI=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# Display on any UEFI machine before a GPU driver loads.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
# simpledrm only binds to the UEFI framebuffer on x86 through SYSFB_SIMPLEFB;
# without it the screen stays black until a GPU driver loads.
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Filesystems used by live/overlay setups.
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
