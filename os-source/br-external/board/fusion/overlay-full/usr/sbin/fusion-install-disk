#!/bin/sh
# fusion-install-disk -- copy the running Fusion OS (from the USB you booted)
# onto an internal disk, so the PC boots Fusion OS without the USB.
#
# !! DESTRUCTIVE: EVERYTHING on the target disk is erased. !!
# It asks you to type the target disk name AND the word APAGAR before it
# writes anything. Run as root:  sudo fusion-install-disk
set -eu

die() { echo "erro: $*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || die "corre como root: sudo fusion-install-disk"

# FUSION_INSTALL_ROOT_PART / FUSION_INSTALL_SRC exist only so the tests can
# point this at loop-device image files instead of real disks.
root_part=${FUSION_INSTALL_ROOT_PART:-$(findmnt -no SOURCE /)}
src=${FUSION_INSTALL_SRC:-/dev/$(lsblk -no PKNAME "$root_part" | head -n 1)}
[ "$src" != "/dev/" ] || die "nao consegui descobrir o disco de arranque"
src_bytes=$(blockdev --getsize64 "$src")

echo
echo "  Fusion OS - instalar no disco interno"
echo "  Disco de arranque atual (origem): $src  ($((src_bytes / 1000000000)) GB)"
echo
echo "  Discos disponiveis (destino possivel):"
lsblk -dno NAME,SIZE,MODEL,TRAN | grep -v "^${src#/dev/} " | grep -vE '^(loop|zram|sr)' | sed 's/^/    /'
echo
printf "  Escreve o NOME do disco de destino (ex: nvme0n1, sda): "
read -r tgt
tgt="/dev/${tgt#/dev/}"
[ -b "$tgt" ] || die "$tgt nao e um disco"
[ "$tgt" != "$src" ] || die "esse e o disco de onde arrancaste"
tgt_bytes=$(blockdev --getsize64 "$tgt")
[ "$tgt_bytes" -ge "$src_bytes" ] || die "o destino e mais pequeno que a origem"

echo
echo "  !!! TUDO o que esta em $tgt vai ser APAGADO para sempre. !!!"
printf "  Para confirmar escreve APAGAR: "
read -r ok
[ "$ok" = "APAGAR" ] || die "cancelado (nada foi escrito)"

echo "  A copiar $src -> $tgt (pode demorar varios minutos)..."
dd if="$src" of="$tgt" bs=4M conv=fsync status=progress

# Give the copy its own GPT identity and root PARTUUID, so the USB and the
# internal disk never get confused at boot if both are plugged in.
sfdisk --relocate gpt-bak-std "$tgt" >/dev/null 2>&1 || true   # backup GPT to the real end
old_uuid=$(blkid -s PARTUUID -o value "$root_part")
new_uuid=$(cat /proc/sys/kernel/random/uuid)
root_num=$(cat "/sys/class/block/$(basename "$root_part")/partition")
sfdisk --disk-id "$tgt" "$(cat /proc/sys/kernel/random/uuid)" >/dev/null
sfdisk --part-uuid "$tgt" "$root_num" "$new_uuid" >/dev/null
partx -u "$tgt" 2>/dev/null || blockdev --rereadpt "$tgt" 2>/dev/null || sleep 2

esp=$(lsblk -lnpo NAME "$tgt" | sed -n 2p)
mnt=$(mktemp -d)
mount "$esp" "$mnt"
sed -i "s/$old_uuid/$new_uuid/g" "$mnt/EFI/BOOT/grub.cfg"
umount "$mnt" && rmdir "$mnt"
sync

echo
echo "  Pronto. Desliga o PC, tira a pen e escolhe $tgt no menu de arranque."
echo "  No primeiro arranque a particao cresce para ocupar o disco todo."
