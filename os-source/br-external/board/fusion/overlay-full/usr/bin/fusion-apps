#!/bin/sh
# fusion-apps -- install Fusion OS's bundled apps from Flathub, per user.
# No account and no sign-in: Steam is installed, you only log into Steam
# yourself, later, if you want to. Safe to re-run (already-installed apps are
# skipped). Exits 0 when offline so the session still starts.

APPS="com.valvesoftware.Steam com.discordapp.Discord com.heroicgameslauncher.hgl org.mozilla.firefox"
STAMP="$HOME/.local/share/fusion/apps-installed"

echo
echo "  Fusion OS - a instalar as aplicacoes:"
echo "  Steam, Discord, Epic (Heroic) e Firefox"
echo "  (so acontece uma vez; depende da velocidade da internet)"
echo

if ! flatpak --user remote-add --if-not-exists flathub \
        https://dl.flathub.org/repo/flathub.flatpakrepo; then
    echo "  ! Sem ligacao ao Flathub. Tenta mais tarde: fusion-apps"
    exit 0
fi

ok=1
for app in $APPS; do
    echo "  -> $app"
    flatpak --user install -y --noninteractive flathub "$app" || ok=0
done

# Steam extras: MangoHud (FPS / frametime overlay) and gamescope. They are
# Flatpak extensions whose branch must match the runtime Steam uses, so read
# it from Steam instead of hard-coding it.
rt=$(flatpak --user info --show-runtime com.valvesoftware.Steam 2>/dev/null)
branch=${rt##*/}
if [ -n "$branch" ] && [ "$branch" != "$rt" ]; then
    echo "  -> MangoHud + gamescope (runtime $branch)"
    flatpak --user install -y --noninteractive flathub \
        "org.freedesktop.Platform.VulkanLayer.MangoHud//$branch" || true
    flatpak --user install -y --noninteractive flathub \
        "org.freedesktop.Platform.VulkanLayer.gamescope//$branch" || true
fi

if [ "$ok" = 1 ]; then
    mkdir -p "$(dirname "$STAMP")" && : > "$STAMP"
    echo "  Aplicacoes instaladas."
else
    echo "  ! Algumas aplicacoes falharam; volta a correr: fusion-apps"
fi
exit 0
