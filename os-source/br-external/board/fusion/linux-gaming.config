# Gaming-edition kernel additions (on top of linux-fragment.config).
# GPU drivers as modules: systemd-udev loads the right one for the machine.
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_RADEON=m
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_NOUVEAU=m
# Firmware loading from /lib/firmware
CONFIG_FW_LOADER=y
# Audio: HD-Audio (almost every PC/laptop) + USB audio
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_USB_AUDIO=m
# Controllers
CONFIG_HID_PLAYSTATION=m
CONFIG_HID_NINTENDO=m
CONFIG_INPUT_UINPUT=y

# More HD-Audio codecs: common in older/business laptops and desktops.
CONFIG_SND_HDA_GENERIC=m
CONFIG_SND_HDA_CODEC_CONEXANT=m
CONFIG_SND_HDA_CODEC_ANALOG=m
CONFIG_SND_HDA_CODEC_SIGMATEL=m
CONFIG_SND_HDA_CODEC_VIA=m
CONFIG_SND_HDA_CODEC_CIRRUS=m
CONFIG_SND_HDA_CODEC_CS8409=m
CONFIG_SND_HDA_CODEC_CA0132=m
CONFIG_SND_HDA_CODEC_SI3054=m
CONFIG_SND_HDA_CODEC_HDMI=m
# Without SOF the kernel's DSP auto-detection falls back to legacy HDA,
# which drives speakers on most machines (not DMIC on newer Intel laptops).
CONFIG_SND_INTEL_DSP_CONFIG=m

# DualSense/DualShock 4 driver (hid-playstation) needs the multicolor LED
# class for the light bar; without it the kernel silently drops the driver
# (CI kernel-config check, full run 44959585589).
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=m
CONFIG_PLAYSTATION_FF=y
