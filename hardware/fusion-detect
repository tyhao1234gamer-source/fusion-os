#!/usr/bin/env python3
"""Print the detected PS4 hardware profile and Fusion recommendation.

    fusion-detect              # detect on this machine
    fusion-detect --pci 104d:908f 1002:9920   # classify given PCI IDs (testing)
"""
import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from fusionhw.detect import classify, detect  # noqa: E402


def main() -> int:
    p = argparse.ArgumentParser(prog="fusion-detect")
    p.add_argument("--pci", nargs="*", help="vendor:device pairs to classify")
    args = p.parse_args()
    if args.pci:
        ids = [tuple(x.lower().split(":")) for x in args.pci]
        rec = classify(ids)
    else:
        rec = detect()
    print(json.dumps(rec.as_dict(), indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
