# =====================================================================
# Fusion Core -- kernel config overlay for PS4 Fusion OS
# =====================================================================
# This is a CONFIG FRAGMENT, not a full defconfig. It is merged on top of a
# community PS4 kernel .config with scripts/kconfig/merge_config.sh so that all
# PS4-specific drivers and patches (Aeolia/Belize/Baikal southbridge, SATA,
# GPU, network) are PRESERVED and only the Fusion tuning is layered on.
#
#   ./scripts/kconfig/merge_config.sh -m .config /path/to/fusion-core.config
#
# NOTHING here raises clocks, voltages or changes thermal limits.
# Every value below is a standard upstream Kconfig symbol.
# BUILD + BOOT TEST ON TARGET REQUIRED before trusting any of it (see
# build-fusion-core.sh). Do not claim a win without a benchmark vs baseline.
# ---------------------------------------------------------------------

# --- Scheduler / latency ---------------------------------------------
# Low-latency desktop preemption suits interactive gaming on the weak Jaguar.
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_VOLUNTARY is not set
CONFIG_PREEMPT_COUNT=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_SCHED_AUTOGROUP=y

# --- CPU frequency ----------------------------------------------------
# Jaguar uses acpi-cpufreq; schedutil is the sane default, performance is
# selectable at runtime by the Fusion Performance Engine.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_X86_ACPI_CPUFREQ=y

# --- Memory management ------------------------------------------------
# zram as compressed swap is a large real win on an 8 GB unified-memory box
# where a chunk is carved out for GPU VRAM.
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZSWAP=y
CONFIG_ZSMALLOC=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# MGLRU: better reclaim behaviour under memory pressure.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# --- I/O scheduling ---------------------------------------------------
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_MQ_IOSCHED_KYBER=y
CONFIG_IOSCHED_BFQ=y

# --- Graphics (PRESERVE PS4 GPU SUPPORT) ------------------------------
# These must stay enabled; the community PS4 tree provides the Liverpool/Neo
# wiring. Listed here so a careless 'make localmodconfig' does not drop them.
CONFIG_DRM=y
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_RADEON=y

# --- Networking latency ----------------------------------------------
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_DEFAULT_FQ_CODEL=y
CONFIG_TCP_CONG_BBR=y

# --- Trim things a dedicated gaming console does not need -------------
# (Reduce idle overhead / attack surface. Review per model before enabling;
#  commented so they are a deliberate opt-in, never an automatic removal.)
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_KGDB is not set
# CONFIG_PROFILING is not set

# --- Input: controllers ----------------------------------------------
CONFIG_HID_SONY=y          # DualShock 4 support
CONFIG_HID_GENERIC=y
CONFIG_JOYSTICK_XPAD=y      # xbox-style pads over USB
CONFIG_INPUT_EVDEV=y        # required by the Gaming Shell gamepad layer
