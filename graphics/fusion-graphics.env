# Fusion Graphics environment -- sourced for every game session.
# Installed to /etc/environment.d/90-fusion-graphics.conf (systemd) and also
# sourced by the Gaming Shell launcher. These are the GPU-side settings that
# attack shader stutter and keep the GCN Liverpool/Neo on known-good paths.
#
# Persistent shader/pipeline caches -- the biggest real stutter win on PS4.
MESA_SHADER_CACHE_DISABLE=false
MESA_SHADER_CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/fusion/mesa
MESA_SHADER_CACHE_MAX_SIZE=4G
# RADV: ACO is already the default compiler; keep the pipeline cache warm.
RADV_PERFTEST=
# DXVK/VKD3D state caches are set per-game by the Compatibility Manager so each
# title gets an isolated cache (see compatibility-manager/fusioncompat/launch.py).
#
# Leave RADV debug off in normal play (logging costs CPU the Jaguar can't spare).
# RADV_DEBUG=
